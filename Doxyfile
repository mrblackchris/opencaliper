# Run from the repository root: doxygen Doxyfile
PROJECT_NAME           = OpenCaliper
PROJECT_BRIEF          = "Open-source data viewer and analyzer"
OUTPUT_DIRECTORY       = docs-api
INPUT                  = opencaliper scripts examples/example.py docs/doxygen
FILE_PATTERNS          = *.py *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
USE_MDFILE_AS_MAINPAGE  =
OPTIMIZE_OUTPUT_JAVA   = YES
PYTHON_DOCSTRING       = NO
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = .
FULL_PATH_NAMES        = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = docs-api/warnings.log
